<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 17+ (targetSdk 37) blocks private-network addresses such as 10.0.2.2 / 192.168.x.x without it. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <!-- Surprise Me: places near the traveler, and check-ins within 150 m of them. Precise or approximate. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Not every phone has a GPS or network location chip; the screen explains what is missing. -->
    <uses-feature android:name="android.hardware.location" android:required="false" />

    <!-- "Take me there" opens a maps app (Android 11+ hides apps that are not declared here). -->
    <queries>
        <package android:name="com.google.android.apps.maps" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Wanderly"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.auth.LoginActivity"
            android:theme="@style/Theme.Wanderly.Auth"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.auth.RegisterActivity"
            android:theme="@style/Theme.Wanderly.Auth"
            android:windowSoftInputMode="adjustResize" />

        <activity android:name=".ui.profile.ProfileActivity" />

        <activity android:name=".ui.profile.CountryVisitsActivity" />

        <activity
            android:name=".ui.profile.EditProfileActivity"
            android:theme="@style/Theme.Wanderly.Auth"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.preferences.PreferencesActivity"
            android:theme="@style/Theme.Wanderly.Auth" />

        <activity
                android:name=".ui.preferences.AdventureActivity"
                android:theme="@style/Theme.Wanderly.Auth"
                android:windowSoftInputMode="adjustResize" />

        <activity android:name=".ui.adventure.PlanActivity" />

        <activity android:name=".ui.surprise.SurpriseActivity" />


    </application>

</manifest>