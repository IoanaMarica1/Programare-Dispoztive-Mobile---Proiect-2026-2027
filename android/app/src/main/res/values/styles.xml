<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Widget.Wanderly.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/ocean_700</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">@dimen/radius_button</item>
    </style>

    <!-- Secondary action on a light card, such as "Add a stop" -->
    <style name="Widget.Wanderly.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton.Icon">
        <item name="android:textColor">@color/text_link</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="iconTint">@color/text_link</item>
        <item name="strokeColor">@color/text_link</item>
    </style>

    <!-- Swap and Remove on a stop card; each one sets its own colour -->
    <style name="Widget.Wanderly.Button.StopAction" parent="Widget.Material3.Button.TextButton.Icon">
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="iconSize">18dp</item>
    </style>

    <!-- Save on the plan's top bar; looks done once the plan is saved -->
    <style name="Widget.Wanderly.Button.Save" parent="Widget.Material3.Button.Icon">
        <item name="backgroundTint">@color/save_button_background</item>
        <item name="android:textColor">@color/save_button_content</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">@dimen/radius_input</item>
        <item name="iconSize">18dp</item>
        <item name="iconTint">@color/save_button_content</item>
    </style>

    <!-- Floats over the map -->
    <style name="Widget.Wanderly.Button.Map" parent="Widget.Material3.Button.ElevatedButton.Icon">
        <item name="backgroundTint">@color/surface_card</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">@dimen/radius_input</item>
        <item name="iconSize">18dp</item>
        <item name="iconTint">@color/text_link</item>
    </style>

    <style name="Widget.Wanderly.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/radius_input</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_input</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_input</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_input</item>
    </style>

    <style name="TextAppearance.Wanderly.Title" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Wanderly.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.Wanderly.Label" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.Wanderly.Section" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Wanderly.Chip" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">16sp</item>
    </style>

    <!-- Large selectable chip used by the preference wizard -->
    <style name="Widget.Wanderly.Chip.Choice" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_background</item>
        <item name="chipStrokeColor">@color/chip_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipMinHeight">@dimen/chip_height</item>
        <item name="chipCornerRadius">@dimen/radius_input</item>
        <item name="chipStartPadding">@dimen/space_s</item>
        <item name="chipEndPadding">@dimen/space_s</item>
        <item name="android:textAppearance">@style/TextAppearance.Wanderly.Chip</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Picks the day on the plan; the selected day stands out strongly -->
    <style name="Widget.Wanderly.Chip.Day" parent="Widget.Wanderly.Chip.Choice">
        <item name="chipBackgroundColor">@color/chip_day_background</item>
        <item name="chipStrokeColor">@color/chip_day_stroke</item>
        <item name="chipMinHeight">40dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="android:textColor">@color/chip_day_text</item>
    </style>

    <!-- Read-only chip that shows a saved preference on the profile -->
    <style name="Widget.Wanderly.Chip.Tag" parent="Widget.Material3.Chip.Assist">
        <item name="chipBackgroundColor">@color/chip_checked_bg</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipCornerRadius">@dimen/radius_input</item>
        <item name="android:textColor">@color/avatar_text</item>
        <item name="android:clickable">false</item>
        <item name="android:focusable">false</item>
    </style>

    <style name="Widget.Wanderly.Progress" parent="Widget.Material3.LinearProgressIndicator">
        <item name="indicatorColor">@color/progress_indicator</item>
        <item name="trackColor">@color/progress_track</item>
        <item name="trackThickness">@dimen/progress_thickness</item>
        <item name="trackCornerRadius">@dimen/space_xs</item>
        <item name="trackStopIndicatorSize">0dp</item>
        <item name="indicatorTrackGapSize">0dp</item>
    </style>

    <!-- Small text action such as "Edit" next to a section title -->
    <style name="Widget.Wanderly.Link" parent="">
        <item name="android:textColor">@color/text_link</item>
        <item name="android:textStyle">bold</item>
        <item name="android:padding">@dimen/space_s</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>
</resources>