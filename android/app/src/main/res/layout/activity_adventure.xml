<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_ocean" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_photo_overlay" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:fitsSystemWindows="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/space_l">

            <ImageView
                android:layout_width="130dp"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:contentDescription="@string/logo_description"
                android:src="@drawable/logo_wanderly" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                app:cardBackgroundColor="@color/card_glass"
                app:cardCornerRadius="@dimen/radius_card"
                app:cardElevation="0dp"
                app:contentPadding="@dimen/space_l"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/adventure_title"
                        android:textAppearance="@style/TextAppearance.Wanderly.Title" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:text="@string/adventure_subtitle"
                        android:textAppearance="@style/TextAppearance.Wanderly.Body" />

                    <!-- D1: opens "Who's coming?"; once friends are added it shows them instead -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/groupEntry"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_m"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardBackgroundColor="@color/chip_checked_bg"
                        app:cardCornerRadius="@dimen/radius_input"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:animateLayoutChanges="true"
                            android:gravity="center_vertical"
                            android:minHeight="64dp"
                            android:orientation="horizontal"
                            android:paddingStart="12dp"
                            android:paddingTop="10dp"
                            android:paddingEnd="@dimen/space_xs"
                            android:paddingBottom="10dp">

                            <ImageView
                                android:id="@+id/groupEntryIcon"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/bg_member_avatar"
                                android:backgroundTint="@color/teal_700"
                                android:importantForAccessibility="no"
                                android:padding="8dp"
                                android:src="@drawable/ic_group"
                                app:tint="@color/white" />

                            <LinearLayout
                                android:id="@+id/groupEntryAvatars"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:visibility="gone" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/groupEntryTitle"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/group_entry_title"
                                    android:textColor="@color/avatar_text"
                                    android:textSize="15sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/groupEntrySubtitle"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/group_entry_subtitle"
                                    android:textColor="@color/avatar_text"
                                    android:textSize="13sp" />
                            </LinearLayout>

                            <ImageButton
                                android:id="@+id/groupEntryClear"
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:contentDescription="@string/group_entry_clear"
                                android:src="@drawable/ic_close"
                                android:visibility="gone"
                                app:tint="@color/avatar_text" />

                            <ImageView
                                android:id="@+id/groupEntryChevron"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_marginEnd="@dimen/space_s"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_chevron_right"
                                app:tint="@color/avatar_text" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/destinationLayout"
                        style="@style/Widget.Wanderly.TextInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_l"
                        android:hint="@string/hint_destination"
                        app:startIconDrawable="@drawable/ic_place">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/destinationInput"
                            style="@style/Widget.Material3.TextInputEditText.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:completionThreshold="2"
                            android:dropDownVerticalOffset="@dimen/space_xs"
                            android:inputType="textCapWords"
                            android:popupBackground="@drawable/bg_dropdown" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Opens the date range picker; not typed into -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/datesLayout"
                        style="@style/Widget.Wanderly.TextInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_s"
                        android:hint="@string/hint_trip_dates"
                        app:startIconDrawable="@drawable/ic_calendar">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/datesInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:cursorVisible="false"
                            android:focusable="false"
                            android:inputType="none" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_l"
                        android:text="@string/adventure_rhythm"
                        android:textAppearance="@style/TextAppearance.Wanderly.Section" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/rhythmGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_s"
                        app:chipSpacingHorizontal="@dimen/space_s"
                        app:chipSpacingVertical="@dimen/space_s"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipEarly"
                            style="@style/Widget.Wanderly.Chip.Choice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/adventure_rhythm_early" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipStandard"
                            style="@style/Widget.Wanderly.Chip.Choice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/adventure_rhythm_standard" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipNight"
                            style="@style/Widget.Wanderly.Chip.Choice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/adventure_rhythm_night" />
                    </com.google.android.material.chip.ChipGroup>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_l"
                        android:text="@string/adventure_pace"
                        android:textAppearance="@style/TextAppearance.Wanderly.Section" />

                    <!-- For this trip only; starts on the pace from the saved preferences -->
                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/paceGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_s"
                        app:chipSpacingHorizontal="@dimen/space_s"
                        app:chipSpacingVertical="@dimen/space_s"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipRelaxed"
                            style="@style/Widget.Wanderly.Chip.Choice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/pace_relaxed" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipBalanced"
                            style="@style/Widget.Wanderly.Chip.Choice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/pace_balanced" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipPacked"
                            style="@style/Widget.Wanderly.Chip.Choice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/pace_packed" />
                    </com.google.android.material.chip.ChipGroup>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/generateButton"
                        style="@style/Widget.Wanderly.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_l"
                        android:text="@string/action_generate_plan" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/generateProgress"
                        style="@style/Widget.Wanderly.Progress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_m"
                        android:indeterminate="true"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
