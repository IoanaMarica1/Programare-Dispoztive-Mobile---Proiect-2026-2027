<?xml version="1.0" encoding="utf-8"?>
<!-- D1: who is coming on a group trip. The trip details stay on the adventure screen. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/travellersRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_xs"
        android:paddingEnd="@dimen/space_m">

        <ImageButton
            android:id="@+id/travellersBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_back"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/text_primary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_xs"
            android:layout_weight="1"
            android:text="@string/travellers_title"
            android:textAppearance="@style/TextAppearance.Wanderly.Section" />

        <!-- How many of the 8 places are taken -->
        <TextView
            android:id="@+id/travellersCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_soft"
            android:drawablePadding="6dp"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:textColor="@color/avatar_text"
            android:textSize="14sp"
            android:textStyle="bold"
            app:drawableStartCompat="@drawable/ic_group"
            app:drawableTint="@color/avatar_text" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/travellersContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:animateLayoutChanges="true"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_m"
            android:paddingEnd="@dimen/space_m"
            android:paddingBottom="@dimen/space_l">

            <TextView
                android:id="@+id/travellersSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_xs"
                android:layout_marginTop="@dimen/space_xs"
                android:textAppearance="@style/TextAppearance.Wanderly.Body" />

            <!-- The organiser, always first; turns into a warning when their preferences are missing -->
            <include
                android:id="@+id/organiserCard"
                layout="@layout/item_traveller"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/travellersList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

            <!-- Shown until the first friend is added -->
            <LinearLayout
                android:id="@+id/travellersEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="@dimen/space_l"
                android:paddingEnd="@dimen/space_l">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:text="🧑‍🤝‍🧑"
                    android:textSize="48sp"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:gravity="center"
                    android:text="@string/travellers_empty_title"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:gravity="center"
                    android:text="@string/travellers_empty_body"
                    android:textAppearance="@style/TextAppearance.Wanderly.Body" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/addTravellerButton"
                style="@style/Widget.Wanderly.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:text="@string/travellers_add"
                app:icon="@drawable/ic_person_add" />

            <TextView
                android:id="@+id/travellersSwipeHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:gravity="center"
                android:text="@string/travellers_swipe_hint"
                android:textAppearance="@style/TextAppearance.Wanderly.Label"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Always reachable, above the keyboard and the list -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_card"
        android:paddingStart="@dimen/space_m"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/space_m"
        android:paddingBottom="12dp">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="-16dp"
            android:layout_marginTop="-12dp"
            android:layout_marginEnd="-16dp"
            android:background="@color/outline_soft" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/travellersDone"
            style="@style/Widget.Wanderly.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/travellers_done" />
    </FrameLayout>
</LinearLayout>
