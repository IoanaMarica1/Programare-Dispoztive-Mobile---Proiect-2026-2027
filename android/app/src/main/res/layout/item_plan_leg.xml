<?xml version="1.0" encoding="utf-8"?>
<!-- The walk between two stops; hidden until the route has loaded -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/space_m"
    android:layout_marginTop="@dimen/space_s"
    android:drawablePadding="@dimen/space_xs"
    android:drawableStart="@drawable/ic_walk"
    android:drawableTint="@color/text_link"
    android:gravity="center_vertical"
    android:textColor="@color/text_link"
    android:textSize="13sp"
    android:textStyle="bold"
    android:visibility="gone" />
