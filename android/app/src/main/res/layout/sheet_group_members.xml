<?xml version="1.0" encoding="utf-8"?>
<!-- Bottom sheet on a group plan: everyone, how many stops suit each of them, and the group actions -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_l"
        android:paddingEnd="@dimen/space_l"
        android:paddingBottom="@dimen/space_l">

        <com.google.android.material.bottomsheet.BottomSheetDragHandleView
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/plan_group_sheet_title"
            android:textAppearance="@style/TextAppearance.Wanderly.Title" />

        <TextView
            android:id="@+id/membersFairness"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:textAppearance="@style/TextAppearance.Wanderly.Body" />

        <LinearLayout
            android:id="@+id/membersList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:orientation="vertical" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/membersRegenerate"
            style="@style/Widget.Wanderly.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:text="@string/plan_group_regenerate"
            app:icon="@drawable/ic_refresh"
            app:iconGravity="textStart" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/membersLeave"
            style="@style/Widget.Wanderly.Button.StopAction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:text="@string/plan_group_leave"
            android:textColor="@color/error"
            android:textSize="15sp"
            app:icon="@drawable/ic_exit"
            app:iconGravity="textStart"
            app:iconTint="@color/error" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
