# Copy to secrets.properties (same folder, next to pom.xml) and fill in. Never commit secrets.properties.

# Free key: https://aistudio.google.com/apikey
gemini.api-key=YOUR_KEY_HERE
gemini.model=gemini-3.5-flash-lite

# JWT signing key: a random string of at least 32 characters, e.g. from
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it logs everyone out.
jwt.secret=CHANGE_ME_TO_A_RANDOM_STRING_OF_32_PLUS_CHARACTERS

# Must match POSTGRES_USER / POSTGRES_PASSWORD in .env
spring.datasource.username=wanderly
spring.datasource.password=CHANGE_ME
